# =============================================================================
# Societal Innovation Portal — Backend environment
# Copy this file to `.env` and fill in real values.
# =============================================================================

# Neon Postgres connection string.
# Format: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# IMPORTANT: Neon requires sslmode=require. Keep it in the URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# JWT
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated list of allowed origins
# For local development:
CORS_ORIGINS=http://localhost:5173

# For production (add your frontend domain):
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# For Docker deployment (add container names):
# CORS_ORIGINS=http://localhost:5173,http://frontend:5173,https://your-domain.com

# AI / LLM (pluggable). Leave CLOUDFLARE_* empty to use the built-in heuristic engine.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_KEY=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
DUPLICATE_THRESHOLD=0.6

# Email OTP (Google SMTP). Paste your sender address + app password below to
# enable real email sending. When EMAIL_USER/EMAIL_PASS are empty, OTP codes are
# printed to the server console (dev mode) so the flow is testable without creds.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=  # sender Gmail address, e.g. you@gmail.com
EMAIL_PASS=  # Gmail app password (NOT your normal password)
EMAIL_FROM_NAME=Socio Connect
OTP_TTL_SECONDS=300
OTP_LENGTH=6
EMAIL_VERIFICATION_REQUIRED=False

# Evidence file storage: "local" (backend/uploads/, served at /uploads/...)
# or "s3" (any S3-compatible bucket — see free options below).
STORAGE_BACKEND=local

# --- S3-compatible storage (only needed when STORAGE_BACKEND=s3) ---
# S3_BUCKET=socio-connect-evidence
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
#
# Pick ONE endpoint style:
#   AWS S3 ............ leave S3_ENDPOINT_URL empty, S3_REGION=us-east-1
#   Cloudflare R2 ..... S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
#   Backblaze B2 ...... S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com, S3_REGION=us-east-005
#   Supabase .......... S3_ENDPOINT_URL=https://<project>.supabase.co/storage/v1/s3, S3_REGION=us-east-1
#   Local MinIO ....... S3_ENDPOINT_URL=http://localhost:9000, S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_REGION=auto
#
# Public URL base for stored files (bucket must allow public reads, or point
# this at a CDN). R2: https://pub-<id>.r2.dev — enable "Public access" on the
# bucket to get it. Empty = auto AWS URL (needs public-read bucket policy).
# S3_PUBLIC_BASE_URL=