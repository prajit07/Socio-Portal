# =============================================================================
# Societal Innovation Portal — Backend environment
# Copy this file to `.env` and fill in real values.
# =============================================================================

# Neon Postgres connection string.
# Format: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# IMPORTANT: Neon requires sslmode=require. Keep it in the URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# JWT
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated list of allowed origins
# For local development:
CORS_ORIGINS=http://localhost:5173

# For production (add your frontend domain):
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# For Docker deployment (add container names):
# CORS_ORIGINS=http://localhost:5173,http://frontend:5173,https://your-domain.com

# AI / LLM (pluggable). Leave CLOUDFLARE_* empty to use the built-in heuristic engine.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_KEY=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
DUPLICATE_THRESHOLD=0.6

# Email OTP (Google SMTP). Paste your sender address + app password below to
# enable real email sending. When EMAIL_USER/EMAIL_PASS are empty, OTP codes are
# printed to the server console (dev mode) so the flow is testable without creds.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=  # sender Gmail address, e.g. you@gmail.com
EMAIL_PASS=  # Gmail app password (NOT your normal password)
EMAIL_FROM_NAME=Socio Connect
OTP_TTL_SECONDS=300
OTP_LENGTH=6
EMAIL_VERIFICATION_REQUIRED=False